# Server
PORT=4000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=absensi_cti3

# JWT Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_random_hex_string
JWT_EXPIRES_IN=7d

# Geofencing
MAX_ACCURACY_METERS=75
ENABLE_GEOFENCING=false

# Email (nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Timezone
APP_TIMEZONE=Asia/Jakarta

# CORS (allowed origins, * for all, or comma-separated URLs)
CORS_ORIGIN=*

# File Uploads directory (relative to project root)
UPLOADS_DIR=uploads
